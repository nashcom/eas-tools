# Settings of eas-probe as environment variables. Every option is EASPROBE_<OPTION>: upper case, "-" written as "_".
# The command line wins over the environment, the environment over a -config file. Values are taken as they are: no
# quotes. The password is not set in this file: see the options below.
EASPROBE_SERVER=traveler.example.com
EASPROBE_USER=probe@example.com
# The password: a file ...
EASPROBE_PASSWORD_FILE=secrets/traveler_lab_password
# ... or the password itself, for a quick test only (anyone who can read this file can read the password; a file wins
# when both are given):
#EASPROBE_PASSWORD=secret-password
EASPROBE_PROFILE=iphone
# info (the default), warn (problems only), debug or trace; the command line (-verbose = debug, -debug = trace) wins
#EASPROBE_LOG_LEVEL=info
EASPROBE_STATE_FILE=probe-state.json
EASPROBE_MAIL=true
EASPROBE_MAIL_WAIT_SECONDS=60
# text (the default) or json: one object per line, in the shape of the log records of the Domino tools (OpenTelemetry field names)
#EASPROBE_LOG_FORMAT=text
