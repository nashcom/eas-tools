# The exporter with one target and no config file, as environment variables, for example:
#   docker run -d --env-file exporter.env -v eas-data:/data -v ./pw.txt:/run/secrets/pw:ro -p 9117:9117 nashcom/eas-tools:latest
# The name of a variable is the key of the JSON config file in upper case with the prefix EASEXPORTER_: "listen" is
# EASEXPORTER_LISTEN, "password_file" is EASEXPORTER_PASSWORD_FILE. The fields of the target (server, user, mail, ...) work
# the same way, and EASEXPORTER_TARGET is its name. More than one target needs the JSON file
# (deploy/exporter-container.example.json); the two can be combined: a variable wins over the file, and EASEXPORTER_TARGET
# picks the target of the file that is changed. Values are taken as they are: no quotes. The password is not set in
# this file: see the options below.

# TLS is the default: the certificate is looked for in /run/secrets/tls (tls.crt, tls.key) and made there when it is not (a volume on that
# directory keeps it). To serve plain HTTP on purpose, for example behind a proxy that terminates TLS, set
#EASEXPORTER_ALLOW_HTTP=true
EASEXPORTER_STATE_FILE=/data/state.json
EASEXPORTER_MIN_INTERVAL_SECONDS=60
# the name used in /probe?target=NAME (default: default)
EASEXPORTER_TARGET=traveler-lab
EASEXPORTER_SERVER=traveler.example.com
EASEXPORTER_USER=probe@example.com
# The password: a file ...
EASEXPORTER_PASSWORD_FILE=/run/secrets/pw
# ... or the password itself, for a quick test only (anyone who can read this file can read the password; a file wins
# when both are given):
#EASEXPORTER_PASSWORD=secret-password
EASEXPORTER_PROFILE=iphone
EASEXPORTER_MAIL=true
EASEXPORTER_MAIL_WAIT_SECONDS=60

# The configuration can also come from an https:// location (see docs/EXPORTER.md); how to fetch it is set here, not there:
#EASEXPORTER_CONFIG=https://config.example.com/eas-tools.json
#EASEXPORTER_CONFIG_TOKEN_FILE=/run/secrets/config_token
#EASEXPORTER_CONFIG_TOKEN_NAME=X-Config-Token
#EASEXPORTER_CONFIG_CHECK_INTERVAL_SECONDS=60

# info (the default), warn (problems only), debug or trace; the command line (-verbose = debug, -debug = trace) wins
#EASEXPORTER_LOG_LEVEL=info
# text (the default) or json: one object per line, in the shape of the log records of the Domino tools (OpenTelemetry field names)
#EASEXPORTER_LOG_FORMAT=text
