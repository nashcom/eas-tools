# Settings of eas-load as environment variables, for example:
#   docker run --rm --env-file load.env -v ./data:/data --entrypoint eas-load nashcom/eas-tools:latest
# Every option is EASLOAD_<OPTION>: upper case, "-" written as "_". The command line wins over the environment, the
# environment over a -config file. Values are taken as they are: no quotes. The password is not set in this file.
EASLOAD_SERVER=traveler.example.com
EASLOAD_USER=loadtest@example.com
# The password: a file ...
EASLOAD_PASSWORD_FILE=/data/pw.txt
# ... or the password itself, for a quick test only (anyone who can read this file can read the password; a file wins
# when both are given):
#EASLOAD_PASSWORD=secret-password
EASLOAD_DEVICES=10
EASLOAD_PROFILE=iphone
EASLOAD_NAME=eas-load
EASLOAD_STATE_FILE=/data/eas-load-state.json
EASLOAD_JOB=eas-mail
EASLOAD_PARAMS=to=self&think=5-10&size=1-5&attach=50-200&files=2&count=3&cleanup=yes
EASLOAD_DURATION=8m
EASLOAD_RAMP=10s
EASLOAD_REPORT=30s
# info (the default), warn (problems only), debug or trace
#EASLOAD_LOG_LEVEL=info
EASLOAD_RESULT_FILE=/data/result.json
# text (the default) or json: one object per line, in the shape of the log records of the Domino tools (OpenTelemetry field names)
#EASLOAD_LOG_FORMAT=text
