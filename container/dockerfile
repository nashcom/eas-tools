# ---- Build stage ----

FROM golang:alpine AS builder
WORKDIR /src

# Modules first, so that they stay cached when only the source changes
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Static binaries: the exporter, the command line probe, the load worker and the mail client (eas-client, see docker-compose.client.yml)
RUN set -e; mkdir -p /tmp/out; for c in eas-blackbox-exporter eas-probe eas-load eas-client; do CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /tmp/out/$c ./cmd/$c; done

# ---- Runtime image ----

FROM alpine

RUN apk add --no-cache ca-certificates && mkdir -p /data /etc/eas-tools /run/secrets/tls && chown 1000:1000 /data /run/secrets/tls

COPY --from=builder /tmp/out/ /usr/local/bin/

# uid 1000 matches the usual first user on a Linux host, so bind mounts and volumes need no chown
USER 1000:1000
VOLUME /data
EXPOSE 9116 9117 9100

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s CMD ["/usr/local/bin/eas-blackbox-exporter", "-health-check"]
ENTRYPOINT ["/usr/local/bin/eas-blackbox-exporter"]
