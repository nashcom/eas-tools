# ---- Build stage ----

FROM --platform=$BUILDPLATFORM cgr.dev/chainguard/go:latest AS builder
WORKDIR /src

# The Go compiler runs on the machine that builds (BUILDPLATFORM) and makes the programs for the image that is built (TARGETARCH): an arm64
# image is cross-compiled, not built under emulation, which would take ten times as long. Without BuildKit both are empty: the host is used.
ARG TARGETOS
ARG TARGETARCH

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN set -e; mkdir -p /tmp/out; for c in eas-blackbox-exporter eas-probe eas-load eas-client eas-mcp; do CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w" -o /tmp/out/$c ./cmd/$c; done

# ---- Runtime stage ----

FROM cgr.dev/chainguard/wolfi-base

COPY --from=builder /tmp/out/ /usr/local/bin/
# the license texts of the libraries in the programs (scripts/licenses.sh makes them)
COPY third_party/licenses/ /usr/share/licenses/eas-tools/
RUN mkdir -p /data /etc/eas-tools /run/secrets/tls && chown 1000:1000 /data /run/secrets/tls

USER 1000:1000
VOLUME /data
EXPOSE 9116 9117 9100

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s CMD ["/usr/local/bin/eas-blackbox-exporter", "-health-check"]
ENTRYPOINT ["/usr/local/bin/eas-blackbox-exporter"]
